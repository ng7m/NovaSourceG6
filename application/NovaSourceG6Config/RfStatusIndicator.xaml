<UserControl x:Class="NovaSourceG6Config.RfStatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="32" Height="16" Focusable="False">
    <Canvas Width="32" Height="16" ClipToBounds="True">
        <Path x:Name="Wave" Stroke="Gray" StrokeThickness="1.7"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.RenderTransform><TranslateTransform x:Name="WaveOffset"/></Path.RenderTransform>
        </Path>
    </Canvas>
</UserControl>
