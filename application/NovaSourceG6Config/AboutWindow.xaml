<Window x:Class="NovaSourceG6Config.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About NovaSource G6 Config" Icon="Assets/NovaSourceG6Config.ico" Width="740" SizeToContent="Height" MinWidth="360" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Width="96" Height="96" VerticalAlignment="Top"
                   Source="Assets/NovaSourceG6Config-256.png"
                   Stretch="Uniform"/>
            <StackPanel Grid.Column="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Text="NovaSource G6 Config"/>
                        <TextBlock x:Name="VersionText" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="2" VerticalAlignment="Top" Background="White" BorderBrush="#D1D5DB"
                            BorderThickness="1" CornerRadius="6" Padding="6">
                        <Button Style="{StaticResource {x:Type Button}}" Background="Transparent" BorderThickness="0"
                                Padding="0" Cursor="Hand" Click="ViewIntroduction_Click"
                                ToolTip="About NovaSource G6 Hardware..."
                                AutomationProperties.Name="About NovaSource G6 Hardware">
                            <Image Source="Assets/G6-device.jpg" Width="150" Stretch="Uniform"/>
                        </Button>
                    </Border>
                </Grid>
                <WrapPanel Margin="0,18,0,0">
                    <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Created by Max NG7M"/>
                    <Button Style="{StaticResource {x:Type Button}}" Padding="12,7" Click="ViewIntroduction_Click" Content="About NovaSource G6 Hardware..."/>
                </WrapPanel>
                <TextBlock Margin="0,4,0,0">
                    <Hyperlink NavigateUri="mailto:ng7m@arrl.net" RequestNavigate="Email_RequestNavigate"
                               Foreground="{DynamicResource TextBrush}" ToolTip="Send email to ng7m@arrl.net">ng7m@arrl.net</Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="This utility will configure a NovaSource G6 Programmable Synthesized RF Signal Source, which are completely self-contained, with an option to use an external reference or internal TCXO reference."/>
                <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Text="Licensed under the GNU General Public License, version 3 or (at your option) any later version."/>
                <TextBlock Margin="0,6,0,0" Text="GPL-3.0-or-later" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="This program is free software and comes with ABSOLUTELY NO WARRANTY. See the license for redistribution terms and details."/>
                <Button Style="{StaticResource {x:Type Button}}" Padding="12,7" Margin="0,12,0,0" HorizontalAlignment="Left" Click="ViewLicense_Click" Content="View full license…"/>
                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"><Bold>Use at your own risk.</Bold><Run Text=" This utility is provided without warranty. Max NG7M is not responsible for unintended device behavior, equipment damage, or other consequences arising from its use, to the extent permitted by applicable law. Verify settings and ensure your equipment is suitable before applying changes."/></TextBlock>
            </StackPanel>
        </Grid></ScrollViewer>
        <Grid Grid.Row="2">
            <Button Style="{StaticResource {x:Type Button}}" Padding="12,7" HorizontalAlignment="Left" Click="CheckForUpdates_Click" Content="Check for updates…"/>
            <Button Style="{StaticResource {x:Type Button}}" Padding="12,7" Width="90" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Content="OK"/>
        </Grid>
    </Grid>
</Window>
