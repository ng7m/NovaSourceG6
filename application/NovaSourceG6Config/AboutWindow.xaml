<Window x:Class="NovaSourceG6Config.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About NovaSource G6 Config" Icon="Assets/NovaSourceG6Config.ico" Width="600" Height="360"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Width="180" Height="180" VerticalAlignment="Top"
                   Source="Assets/NovaSourceG6Config-256.png"
                   Stretch="Uniform"/>
            <StackPanel Grid.Column="2">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="NovaSource G6 Config"/>
                <TextBlock x:Name="VersionText" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" Text="Configuration and monitoring utility for the NovaSource G6 RF Signal Source."/>
                <TextBlock Margin="0,14,0,0" Text="Serial interface: 38400 baud, 8 data bits, no parity, 1 stop bit" TextWrapping="Wrap"/>
                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="Supports device-state monitoring, RF and modulation configuration, trigger control, nonvolatile settings, and frequency sweeps." TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
        <Button Grid.Row="2" Width="90" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Content="OK"/>
    </Grid>
</Window>
