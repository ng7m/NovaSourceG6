<Window x:Class="NovaSourceG6Config.ModulationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Modulation Settings" Width="600" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}" SizeToContent="Height" MinHeight="240" MinWidth="360">
    <DockPanel Margin="24"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button Width="90" IsCancel="True" Content="Cancel" />
            <Button x:Name="ApplyButton" Width="90" Margin="8,0,0,0" Click="Apply_Click" Content="Apply" IsEnabled="False" />
        </StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="170" /><ColumnDefinition Width="24" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Source:" />
            <ComboBox x:Name="SourceSelector" Grid.Column="2" SelectionChanged="SourceSelector_SelectionChanged"><ComboBoxItem Content="Off" Tag="N" /><ComboBoxItem Content="Internal 1 kHz" Tag="I" /><ComboBoxItem Content="External" Tag="E" /></ComboBox>
            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Gain:" ToolTip="The modulation multiplier is 2 raised to this value." />
            <StackPanel Grid.Column="6" Orientation="Horizontal">
                <Button x:Name="GainDownButton" Width="38" Click="GainDown_Click" Content="−" />
                <TextBox x:Name="GainTextBox" Width="58" Margin="4,0" TextAlignment="Center" TextChanged="GainTextBox_Changed" ToolTip="Gain exponent from -10 through +13" />
                <Button x:Name="GainUpButton" Width="38" Click="GainUp_Click" Content="+" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="MultiplierText" Grid.Row="2" Foreground="{DynamicResource SecondaryTextBrush}" />
        <Border Grid.Row="4" Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <TextBlock TextWrapping="Wrap" Text="External modulation uses the shared rear TRIG/MOD input. Applying External automatically changes the rear-input mode to Modulation, which disables external triggering." />
        </Border>
        
    </Grid></ScrollViewer></DockPanel>
</Window>
