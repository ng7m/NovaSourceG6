<Window x:Class="NovaSourceG6Config.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NovaSource G6 Config (Max NG7M / ng7m@arrl.net)" Icon="Assets/NovaSourceG6Config.ico" Height="620" Width="660" MinHeight="620" MinWidth="580" Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized" Closed="Window_Closed" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources>
  <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}"><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Padding" Value="14"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="12,7"/><Setter Property="MinWidth" Value="82"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="30"/></Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="30"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <GroupBox Grid.Row="0" Header="Connection" Margin="0"><Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="180"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock VerticalAlignment="Center" Text="Serial port"/><ComboBox x:Name="PortSelector" Grid.Column="2" SelectionChanged="PortSelector_SelectionChanged" DropDownClosed="PortSelector_DropDownClosed"/>
   <Button x:Name="RefreshPortsButton" Grid.Column="4" Click="RefreshPorts_Click" Content="Refresh"/><Button x:Name="ConnectionButton" Grid.Column="6" Click="ConnectionButton_Click" Content="Connect" IsEnabled="False"/>
   <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="7" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"><Ellipse x:Name="ConnectionIndicator" Width="12" Height="12" Fill="#DC2626" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionStateText" Text="Disconnected" FontWeight="SemiBold"/></StackPanel>
  </Grid></GroupBox>
  <Grid x:Name="DevicePanel" Grid.Row="2" IsEnabled="False">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <GroupBox Header="RF Output" Margin="0,0,0,12"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock VerticalAlignment="Center" Text="Frequency"/><TextBox x:Name="FrequencyTextBox" Grid.Column="2" TextChanged="EditableControl_Changed"/><TextBlock Grid.Column="4" VerticalAlignment="Center" Text="MHz"/>
    <TextBlock Grid.Row="2" Text="Step" VerticalAlignment="Center"/><ComboBox x:Name="FrequencyStepSelector" Grid.Row="2" Grid.Column="2" SelectedIndex="0"><ComboBoxItem Content="0.001 MHz (1 kHz)" Tag="0.001"/><ComboBoxItem Content="0.010 MHz (10 kHz)" Tag="0.010"/><ComboBoxItem Content="0.100 MHz (100 kHz)" Tag="0.100"/><ComboBoxItem Content="1.000 MHz" Tag="1.000"/></ComboBox>
    <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal"><Button Click="FrequencyDown_Click" Content="−" MinWidth="38"/><Button Click="FrequencyUp_Click" Content="+" MinWidth="38" Margin="4,0,0,0"/></StackPanel>
    <TextBlock Grid.Row="4" Text="Device range"/><TextBlock x:Name="FrequencyRangeText" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Foreground="{DynamicResource SecondaryTextBrush}"/>
    <TextBlock Grid.Row="6" Text="Attenuation" VerticalAlignment="Center"/><ComboBox x:Name="AttenuationSelector" Grid.Row="6" Grid.Column="2" SelectionChanged="EditableControl_Changed"/>
    <StackPanel Grid.Row="6" Grid.Column="4" Orientation="Horizontal"><Button Click="AttenuationDown_Click" Content="−" MinWidth="38"/><Button Click="AttenuationUp_Click" Content="+" MinWidth="38" Margin="4,0,0,0"/></StackPanel>
    <StackPanel Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left"><Button Click="OpenSweep_Click" Content="Frequency Sweep..."/><Button Margin="8,0,0,0" Click="OpenModulation_Click" Content="Modulation…"/><Button Margin="8,0,0,0" Click="OpenTrigger_Click" Content="Trigger..."/></StackPanel>
   </Grid></GroupBox>
   <GroupBox Grid.Row="1" Grid.Column="0" Header="Device Configuration" Margin="0"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Button x:Name="RefreshStateButton" Grid.Row="0" Grid.Column="0" Click="RefreshState_Click" Content="Read from G6"/><Button x:Name="ApplyButton" Grid.Row="0" Grid.Column="2" Click="Apply_Click" Content="Apply Changes" IsEnabled="False"/><Button Grid.Row="2" Grid.Column="0" Click="Load_Click" Content="Restore Saved Settings"/>
    <Button x:Name="StoreButton" Grid.Row="2" Grid.Column="2" Click="Store_Click" Content="Save to G6" IsEnabled="False"/>
   </Grid></GroupBox>
  </Grid>
  <Grid Grid.Row="3" Margin="0,16,0,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="G6 Status" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center"/>
     <Ellipse x:Name="RfIndicator" Width="12" Height="12" Fill="#DC2626"/><TextBlock Text="RF" Margin="6,0,14,0" VerticalAlignment="Center"/>
     <Ellipse x:Name="LockIndicator" Width="12" Height="12" Fill="#DC2626"/><TextBlock Text="PLL Lock" Margin="6,0,14,0" VerticalAlignment="Center"/>
     <Ellipse x:Name="PowerIndicator" Width="12" Height="12" Fill="#DC2626"/><TextBlock Text="Power" Margin="6,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
   </Border>
   <Border Grid.Row="2" Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"><TextBlock x:Name="StatusMessage" TextWrapping="Wrap" VerticalAlignment="Center" Text="Select a serial port to connect."/></Border>
  </Grid>
 </Grid>
</Window>
